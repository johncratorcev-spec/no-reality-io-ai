generator client {
  provider = "prisma-client-js"
  /* Рантайм Netlify-функций — Amazon Linux (rhel), а сборка идёт на Ubuntu:
     native покрывает локальную разработку и билд-машину, rhel-openssl-3.0.x
     и rhel-openssl-1.1.x — возможные варианты рантайма лямбды. Без них
     query engine не загрузится в функции и клики/рейтинг не будут считаться. */
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Уникальные переходы по UTM-ссылкам.
// unique(utmCode, visitorHash) — защита от повторных кликов одного visitor'а.
model Click {
  id           String   @id @default(uuid())
  utmCode      String
  visitorHash  String
  createdAt    DateTime @default(now())

  @@unique([utmCode, visitorHash])
}

// Посещения страниц (pageviews): пишет /api/track (sendBeacon из layout).
// visitorHash — анонимный отпечаток (ip + ua + секрет, как в Click);
// path — путь страницы ("/", "/market", …); referrer — document.referrer.
// Это НЕ дедуп: каждый pageview = строка, уникальные посетители считаются
// как COUNT(DISTINCT visitorHash) в /api/admin/stats.
model PageVisit {
  id          String   @id @default(uuid())
  path        String
  visitorHash String
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([visitorHash])
}

// Аггрегированный счётчик уникальных кликов = рейтинг видео.
model PostStats {
  utmCode   String   @id
  score     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Реферальный профиль: кошелёк MetaMask → его пригласительный код.
// Код детерминирован (sha256(wallet+salt), src/lib/referral.ts), здесь
// храним только соответствие code → wallet, чтобы админ мог выплатить
// % на кошелёк пригласившего. Запись создаётся при первом коннекте.
model ReferralProfile {
  wallet    String   @id // 0x… в нижнем регистре
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Реферальные события для реестра выплат:
//   checkout — инвойс создан с ?ref=<code> (код вшит в orderId);
//   paid     — инвойс оплачен: рефереру начислена доля REFERRAL_RATE_PCT.
// best-effort: на serverless БД может быть недоступна — атрибуция
// всё равно не теряется (код живёт в orderId у 2328.io).
model ReferralEvent {
  id         String   @id @default(uuid())
  orderId    String   @unique // pd-<id>-<ref>
  refCode    String
  kind       String // checkout | paid
  amountUsdt String? // заполняется при kind=paid
  payoutUsdt String? // доля рефереру при kind=paid
  createdAt  DateTime @default(now())

  @@index([refCode])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cryo-Stop — рынок предсказаний на концовку ролика (пари-мьютюэль в USDC).
//
// Рынок конфиг-driven (src/lib/cryo/config.ts): ensureCryoMarkets() идемпотентно
// создаёт строки по postCode при первом обращении к /api/cryo/markets, поэтому
// фича работает и до ручного сида. Ставки — только в БД; если БД недоступна,
// клиент деградирует в localStorage-ставку (UX живёт, полоса толпы пустая).
//
// status: live → expired (по endsAt) → resolved (оракул: result yes|no).
model CryoMarket {
  id         String    @id @default(uuid())
  postCode   String    @unique // utm_code поста из posts.csv
  question   String
  labelYes   String    @default("YES")
  labelNo    String    @default("NO")
  status     String    @default("live") // live | expired | resolved
  endsAt     DateTime
  result     String? // "yes" | "no" — вердикт оракула
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bets CryoBet[]
  options CryoOption[]

  @@index([status])
}

// Одна позиция на кошелёк на рынок (фикс $1 USDC): Block 5 спеки —
// атомарный обмен через Phantom; в MVP сумма фикс, поэтому unique-констрейнт.
// payout заполняется при resolve (пари-мьютюэль: доля победившего пула).
model CryoBet {
  id        String    @id @default(uuid())
  marketId  String
  wallet    String // Solana base58 или EVM 0x… (lowercase), demo-кошельки: demo:*
  side      String // "yes" | "no"
  amount    String    @default("1.00") // USDC, decimal-строка
  mode      String    @default("demo") // demo | phantom
  txSig     String? // подпись транзакции (когда phantom-режим)
  claimed   Boolean   @default(false)
  claimedAt DateTime?
  payout    String? // выплата при resolve (decimal-строка), null = проигрыш
  createdAt DateTime  @default(now())

  market CryoMarket @relation(fields: [marketId], references: [id])

  @@unique([marketId, wallet])
  @@index([marketId, side])
}

// Опции нарративного рынка «what happens next» (task 44, п.4):
// 2–4 понятных варианта развития сцены вместо голого YES/NO.
// Для 2-опционных рынков ключи остаются "yes"/"no" — совместимо
// с существующими ставками (CryoBet.side = ключ опции).
// Пусто в таблице → рынок деградирует к labelYes/labelNo.
model CryoOption {
  id       String     @id @default(uuid())
  marketId String
  key      String // "yes" | "no" | нарративный ключ ("fall", "boom", …)
  label    String // человеческая формулировка («it all explodes»)
  idx      Int        @default(0) // порядок показа
  market   CryoMarket @relation(fields: [marketId], references: [id])

  @@unique([marketId, key])
}

// Избранное (task 43, п.4): после авторизации по кошельку зритель
// добавляет видео из ленты в избранное. Одна запись на (wallet, postCode).
// Гостям (без кошелька) кнопка недоступна — API требует сессию.
model Favorite {
  id        String   @id @default(uuid())
  wallet    String // lowercase base58 / 0x… — из сессии (cookie)
  postCode  String // utm_code поста из posts.csv
  createdAt DateTime @default(now())

  @@unique([wallet, postCode])
  @@index([wallet])
  @@index([postCode])
}

// Агрегат счётчика избранного (task 44, п.2): «X авторизованных
// пользователей добавили в избранное» на карточке видео.
// Поддерживается транзакционно в api/favorites (POST/DELETE);
// чтение — один findMany по кодам, поверх — in-memory кэш 30с.
model FavoriteStats {
  postCode  String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Покупка промпта: оплата через 2328.io → разблокировка prompt_full.
//
// Жизненный цикл status:
//   pending          — платёжная сессия создана, ждём оплату (webhook)
//   paid             — оплата подтверждена подписанным webhook'ом
//   ready_for_payout — ждёт выплаты автору (полуавто-режим по умолчанию)
//   payout_sent      — выплата отправлена/завершена (payout webhook completed)
//   failed           — cancel/underpaid или payout failed без ретрая
//   aml_hold         — 2328 пометил платёж AML-локом (ручная работа)
//
// Идемпотентность:
//   orderId   ("nr-" + id) — ключ создания платежа в 2328: повторный POST
//                      с тем же orderId возвращает существующую сессию;
//   paymentId (uuid 2328) — уникальный, повторный webhook не создаёт дубль;
//   payoutOrderId — генерируется с номером попытки, чтобы ретрай после
//                      failed делал НОВУЮ выплату, а не возвращал старую.
model Purchase {
  id            String    @id @default(uuid())
  utmCode       String
  buyerHash     String
  orderId       String    @unique
  paymentId     String    @unique
  paymentStatus String    @default("pending")
  currency      String    @default("USDT")
  amountUsdt    String    @default("0")
  platformFee   String    @default("0")
  sellerAmount  String    @default("0")
  status        String    @default("pending")
  txid          String?
  payoutId      String?
  payoutOrderId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paidAt        DateTime?
  payoutAt      DateTime?

  @@index([utmCode])
  @@index([buyerHash])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task 44 — персональные UTM, бонусы, Magic Link.
// ─────────────────────────────────────────────────────────────────────────────

// Переходы по ПЕРСОНАЛЬНЫМ ссылкам пользователя (task 44, п.4):
// владелец кода (ReferralProfile.code) делится ссылкой на ЛЮБОЙ объект —
// видео (/v/[code]), рынок, баннер, промпт — и каждый уникальный
// посетитель считается один раз на (owner, target).
// visitorHash — тот же анонимный отпечаток ip+ua+секрет, что в Click:
// дедуп через unique-констрейнт, накрутка бессмысленна.
model UtmClick {
  id          String   @id @default(uuid())
  ownerCode   String // персональный код автора ссылки (r…)
  targetType  String // video | market | banner | prompt | page
  targetId    String   @default("") // utm_code поста / код промпта / пусто
  visitorHash String
  createdAt   DateTime @default(now())

  @@unique([ownerCode, targetType, targetId, visitorHash])
  @@index([ownerCode])
  @@index([targetType, targetId])
}

// Профиль пользователя (task 44, п.5): кошелёк → виральные бонусы.
// bonusCredits — бесплатные прогнозы без риска (mode "bonus" в CryoBet);
// badges — JSON-массив строк ("early", "seer"); invitedBy — код
// пригласившего при первом входе (обоим начисляется бонус).
model UserProfile {
  wallet       String   @id // lowercase base58 / 0x…
  bonusCredits Int      @default(0)
  badges       String   @default("[]") // JSON: ["early","seer"]
  invitedBy    String? // персональный код пригласившего (если был)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Task 45 — Stripe-продажа промптов картой (test mode) + реферальный %.
// ─────────────────────────────────────────────────────────────────────────────

// Заказ витрины промптов (/market), оплаченный КАРТОЙ через Stripe
// Checkout (hosted). Параллельный канал к 2328.io (USDT): каталог товаров —
// src/lib/market/catalog.ts, полные тексты — data/prompts.csv (utm_code).
//
// Жизненный цикл status:
//   pending — сессия создана, ждём оплату (webhook / реконсиляция)
//   paid    — checkout.session.completed с payment_status=paid
//   expired — checkout.session.expired (или истекла по expires_at)
//
// Идемпотентность: sessionId уникален, перевод статуса — updateMany
// «из pending», повторный webhook находит 0 строк и получает 200.
// Атрибуция реферера живёт в metadata сессии И в refCode здесь —
// при paid пишем ReferralEvent (kind=paid, сумма в USD-строке).
model StripeOrder {
  id              String    @id @default(uuid())
  productCode     String // код из MARKET_ITEMS ("neon-rain", …)
  buyerHash       String // nr_buyer cookie (anonymous UUID)
  buyerWallet     String? // lowercase 0x… — если покупатель авторизован
  refCode         String? // персональный код пригласившего (r…)
  sessionId       String?   @unique // cs_test_… / cs_live_… (пишется после create)
  paymentIntentId String? // pi_… (заполняется webhook'ом)
  amountCents     Int // цена в центах (1200 = $12.00)
  currency        String    @default("usd")
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  paidAt          DateTime?

  @@index([productCode])
  @@index([buyerHash])
  @@index([status])
}

// Одноразовые токены Magic Link (task 44, п.6): email-вход как ДОПОЛНЕНИЕ
// к кошельку. Храним только sha256(token) — утечка БД не раскрывает ссылки.
// TTL 15 минут, одноразовый (usedAt), ставка через Resend (free 3000/мес).
model MagicLogin {
  id        String    @id @default(uuid())
  email     String // lowercase
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Email-аккаунт с опционально привязанным кошельком (task 44, п.6):
// связывание обеих личностей — при verify с активной wallet-сессией
// или при wallet-авторизации с активной email-сессией (best-effort).
model MagicUser {
  email     String   @id // lowercase
  wallet    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
