generator client {
  provider = "prisma-client-js"
  /* Рантайм Netlify-функций — Amazon Linux (rhel), а сборка идёт на Ubuntu:
     native покрывает локальную разработку и билд-машину, rhel-openssl-3.0.x
     и rhel-openssl-1.1.x — возможные варианты рантайма лямбды. Без них
     query engine не загрузится в функции и клики/рейтинг не будут считаться. */
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Уникальные переходы по UTM-ссылкам.
// unique(utmCode, visitorHash) — защита от повторных кликов одного visitor'а.
model Click {
  id           String   @id @default(uuid())
  utmCode      String
  visitorHash  String
  createdAt    DateTime @default(now())

  @@unique([utmCode, visitorHash])
}

// Аггрегированный счётчик уникальных кликов = рейтинг видео.
model PostStats {
  utmCode   String   @id
  score     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Покупка промпта: оплата через 2328.io → разблокировка prompt_full.
//
// Жизненный цикл status:
//   pending          — платёжная сессия создана, ждём оплату (webhook)
//   paid             — оплата подтверждена подписанным webhook'ом
//   ready_for_payout — ждёт выплаты автору (полуавто-режим по умолчанию)
//   payout_sent      — выплата отправлена/завершена (payout webhook completed)
//   failed           — cancel/underpaid или payout failed без ретрая
//   aml_hold         — 2328 пометил платёж AML-локом (ручная работа)
//
// Идемпотентность:
//   orderId   ("nr-" + id) — ключ создания платежа в 2328: повторный POST
//                      с тем же orderId возвращает существующую сессию;
//   paymentId (uuid 2328) — уникальный, повторный webhook не создаёт дубль;
//   payoutOrderId — генерируется с номером попытки, чтобы ретрай после
//                      failed делал НОВУЮ выплату, а не возвращал старую.
model Purchase {
  id            String    @id @default(uuid())
  utmCode       String
  buyerHash     String
  orderId       String    @unique
  paymentId     String    @unique
  paymentStatus String    @default("pending")
  currency      String    @default("USDT")
  amountUsdt    String    @default("0")
  platformFee   String    @default("0")
  sellerAmount  String    @default("0")
  status        String    @default("pending")
  txid          String?
  payoutId      String?
  payoutOrderId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paidAt        DateTime?
  payoutAt      DateTime?

  @@index([utmCode])
  @@index([buyerHash])
  @@index([status])
}
