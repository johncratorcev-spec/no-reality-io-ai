generator client {
  provider = "prisma-client-js"
  /* Рантайм Netlify-функций — Amazon Linux (rhel), а сборка идёт на Ubuntu:
     native покрывает локальную разработку и билд-машину, rhel-openssl-3.0.x
     и rhel-openssl-1.1.x — возможные варианты рантайма лямбды. Без них
     query engine не загрузится в функции и клики/рейтинг не будут считаться. */
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  /* Runtime (Vercel/локалка) — Supavisor pooler, transaction mode :6543
     (+ pgbouncer=true в строке: отключает prepared statements Prisma).
     DDL (db push / migrate) идёт через DIRECT_URL (session mode :5432). */
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Уникальные переходы по UTM-ссылкам.
// unique(utmCode, visitorHash) — защита от повторных кликов одного visitor'а.
model Click {
  id           String   @id @default(uuid())
  utmCode      String
  visitorHash  String
  createdAt    DateTime @default(now())

  @@unique([utmCode, visitorHash])
}

// Посещения страниц (pageviews): пишет /api/track (sendBeacon из layout).
// visitorHash — анонимный отпечаток (ip + ua + секрет, как в Click);
// path — путь страницы ("/", "/market", …); referrer — document.referrer.
// Это НЕ дедуп: каждый pageview = строка, уникальные посетители считаются
// как COUNT(DISTINCT visitorHash) в /api/admin/stats.
model PageVisit {
  id          String   @id @default(uuid())
  path        String
  visitorHash String
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([visitorHash])
}

// Аггрегированный счётчик уникальных кликов = рейтинг видео.
// v13: featuredUntil — флаг «Featured» из BD-панели (поднятие в ленте
// и бейдж); хранится здесь, а не в CSV, чтобы ставить из админки без
// коммита в GitHub.
model PostStats {
  utmCode      String    @id
  score        Int       @default(0)
  featuredUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

// v13 — Daily Challenge: один выделенный раунд дня с повышенным банком
// (победителям раунда сверху начисляется бонус — см. ECON.dailyChallengeBonus).
// day — UTC-дата «YYYY-MM-DD», уникальна → один челлендж на день.
model DailyChallenge {
  day      String   @id // YYYY-MM-DD (UTC)
  clipCode String // utm_code клипа из posts.csv
  label    String   @default("") // опциональная подпись BD (для UI)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipCode])
}

// v13 — Human vs AI Agents Arena: предсказания ИИ-агентов по открытым
// раундам. Агент авторизуется ARENA key (x-agent-key), имя — самообъявленное
// (агрегация статистики по нему). truth НЕ хранится и не утекает —
// вердикт виден только после резолва раунда.
model ArenaPrediction {
  id        String   @id @default(uuid())
  roundId   String
  clipCode  String
  agentName String // самообъявленное имя агента (санитизировано)
  call      String // real | synth
  reasoning String   @default("") // короткое обоснование от LLM
  correct   Boolean? // заполняется при резолве раунда (best-effort)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, agentName])
  @@index([agentName])
  @@index([clipCode])
}

// Реферальный профиль: кошелёк MetaMask → его пригласительный код.
// Код детерминирован (sha256(wallet+salt), src/lib/referral.ts), здесь
// храним только соответствие code → wallet, чтобы админ мог выплатить
// % на кошелёк пригласившего. Запись создаётся при первом коннекте.
model ReferralProfile {
  wallet    String   @id // 0x… в нижнем регистре
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Реферальные события для реестра выплат:
//   checkout — инвойс создан с ?ref=<code> (код вшит в orderId);
//   paid     — инвойс оплачен: рефереру начислена доля REFERRAL_RATE_PCT.
// best-effort: на serverless БД может быть недоступна — атрибуция
// всё равно не теряется (код живёт в orderId у 2328.io).
model ReferralEvent {
  id         String   @id @default(uuid())
  orderId    String   @unique // pd-<id>-<ref>
  refCode    String
  kind       String // checkout | paid
  amountUsdt String? // заполняется при kind=paid
  payoutUsdt String? // доля рефереру при kind=paid
  createdAt  DateTime @default(now())

  @@index([refCode])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cryo-Stop — рынок предсказаний на концовку ролика (пари-мьютюэль в USDC).
//
// Рынок конфиг-driven (src/lib/cryo/config.ts): ensureCryoMarkets() идемпотентно
// создаёт строки по postCode при первом обращении к /api/cryo/markets, поэтому
// фича работает и до ручного сида. Ставки — только в БД; если БД недоступна,
// клиент деградирует в localStorage-ставку (UX живёт, полоса толпы пустая).
//
// status: live → expired (по endsAt) → resolved (оракул: result yes|no).
model CryoMarket {
  id         String    @id @default(uuid())
  postCode   String    @unique // utm_code поста из posts.csv
  question   String
  labelYes   String    @default("YES")
  labelNo    String    @default("NO")
  status     String    @default("live") // live | expired | resolved
  endsAt     DateTime
  result     String? // "yes" | "no" — вердикт оракула
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bets CryoBet[]
  options CryoOption[]

  @@index([status])
}

// Одна позиция на кошелёк на рынок (фикс $1 USDC): Block 5 спеки —
// атомарный обмен через Phantom; в MVP сумма фикс, поэтому unique-констрейнт.
// payout заполняется при resolve (пари-мьютюэль: доля победившего пула).
model CryoBet {
  id        String    @id @default(uuid())
  marketId  String
  wallet    String // Solana base58 или EVM 0x… (lowercase), demo-кошельки: demo:*
  side      String // "yes" | "no"
  amount    String    @default("1.00") // USDC, decimal-строка
  mode      String    @default("demo") // demo | phantom
  txSig     String? // подпись транзакции (когда phantom-режим)
  claimed   Boolean   @default(false)
  claimedAt DateTime?
  payout    String? // выплата при resolve (decimal-строка), null = проигрыш
  createdAt DateTime  @default(now())

  market CryoMarket @relation(fields: [marketId], references: [id])

  @@unique([marketId, wallet])
  @@index([marketId, side])
}

// Опции нарративного рынка «what happens next» (task 44, п.4):
// 2–4 понятных варианта развития сцены вместо голого YES/NO.
// Для 2-опционных рынков ключи остаются "yes"/"no" — совместимо
// с существующими ставками (CryoBet.side = ключ опции).
// Пусто в таблице → рынок деградирует к labelYes/labelNo.
model CryoOption {
  id       String     @id @default(uuid())
  marketId String
  key      String // "yes" | "no" | нарративный ключ ("fall", "boom", …)
  label    String // человеческая формулировка («it all explodes»)
  idx      Int        @default(0) // порядок показа
  market   CryoMarket @relation(fields: [marketId], references: [id])

  @@unique([marketId, key])
}

// Избранное (task 43, п.4): после авторизации по кошельку зритель
// добавляет видео из ленты в избранное. Одна запись на (wallet, postCode).
// Гостям (без кошелька) кнопка недоступна — API требует сессию.
model Favorite {
  id        String   @id @default(uuid())
  wallet    String // lowercase base58 / 0x… — из сессии (cookie)
  postCode  String // utm_code поста из posts.csv
  createdAt DateTime @default(now())

  @@unique([wallet, postCode])
  @@index([wallet])
  @@index([postCode])
}

// Агрегат счётчика избранного (task 44, п.2): «X авторизованных
// пользователей добавили в избранное» на карточке видео.
// Поддерживается транзакционно в api/favorites (POST/DELETE);
// чтение — один findMany по кодам, поверх — in-memory кэш 30с.
model FavoriteStats {
  postCode  String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// v6 — внутренняя экономика: аккаунт с нулевым порогом входа, внутренний
// баланс и крипто-пополнение через 2328.io.
//
// ПОРОГ ВХОДА = 0: аккаунт создаётся лениво по httpOnly-cookie nr_uid
// (первый клик/ставка/награда). Ни email, ни кошелёк, ни формы не нужны.
// Кошелёк (MetaMask/Phantom) или magic-link email привязываются опционально
// и открывают NR PASS (пасс авторизованного: daily-бонус, повышенные капсы,
// leaderboard, будущая конвертация в токен).
model Account {
  id           String    @id // uuid из cookie nr_uid
  wallet       String?   @unique // 0x… / base58, lowercase — привязка кошелька
  email        String?   @unique // magic-link email (опционально)
  // v11 — Telegram-вход (единственный вход кампании Season 1):
  // telegramId уникален → один аккаунт на человека, дубли в снапшоте
  // исключены конструкцией. tgUsername/displayName — для UI-чипа и CSV.
  telegramId   String?   @unique // числовой user id Telegram (строкой)
  tgUsername   String? // @username без собаки
  displayName  String? // first_name [+ last_name] из Telegram
  passTier     Int       @default(0) // 0 = guest, 1 = NR PASS
  balanceCents Int       @default(0) // кэш баланса; истина — LedgerTxn
  lastDailyAt  DateTime? // последний daily-бонус (UTC-день)
  streakDays   Int       @default(0) // подряд дней с daily-бонусом
  // v14 — рефералка: код у всех с регистрации; revshare активируется
  // разовой оплатой 3 USDT (invoice rev-<accountId>); USDT-балансы в центах.
  refCode        String?  @unique // персональный код (?ref=код)
  referredById   String? // код/аккаунт пригласившего (самоприглашение не пишется)
  revshare       Boolean  @default(false) // процент включён (3 USDT уплачены)
  refEarnedCents Int      @default(0) // накоплено USDT-центов по 20% с пачек рефералов
  refPaidCents   Int      @default(0) // выплачено админом
  refBurnedCents Int      @default(0) // сгорело до включения revshare (не возвращается)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  txns   LedgerTxn[]
  deposits DepositOrder[]
  emailAuth EmailAuth?

  @@index([wallet])
}

// Двусторонний журнал внутренней валюты — ЕДИНСТВЕННЫЙ источник истины.
// Каждое движение атомарно (updateMany с guard'ом баланса) и идемпотентно
// (refKey unique: повторный webhook/клик не даст дубль).
// kind: signup_bonus | daily_bonus | click_reward | utm_reward |
//       bet_stake | bet_payout | deposit | deposit_demo
model LedgerTxn {
  id        String   @id @default(uuid())
  accountId String
  delta     Int // + начисление, − списание
  kind      String
  refKey    String?  @unique // идемпотент-ключ ("bet:<id>", "deposit:<uuid>", …)
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([accountId, kind, createdAt])
  @@index([kind, createdAt])
}

// Крипто-пополнение внутреннего баланса: инвойс 2328.io (orderId dp-<id>)
// → подписанный webhook paid → зачисление в LedgerTxn (источник истины —
// только webhook, никакой клиентский поллинг деньгами не управляет).
// В dev/demo (без 2328-ключей) — мгновенное demo-пополнение с дневным капсом.
model DepositOrder {
  id          String    @id @default(uuid())
  accountId   String
  orderId     String    @unique // dp-<id>
  paymentId   String?   @unique // uuid платежа 2328 (webhook)
  amountCents Int
  // v7: бонус-мультипликатор пакета (0/10/25%) — начисляется тем же
  // вебхуком отдельной ledger-строкой deposit_bonus:<paymentId>
  bonusCents  Int       @default(0)
  status      String    @default("pending") // pending | paid | failed
  mode        String    @default("crypto") // crypto | demo
  txid        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task 44 — персональные UTM, бонусы, Magic Link.
// ─────────────────────────────────────────────────────────────────────────────

// Переходы по ПЕРСОНАЛЬНЫМ ссылкам пользователя (task 44, п.4):
// владелец кода (ReferralProfile.code) делится ссылкой на ЛЮБОЙ объект —
// видео (/v/[code]), рынок, баннер, промпт — и каждый уникальный
// посетитель считается один раз на (owner, target).
// visitorHash — тот же анонимный отпечаток ip+ua+секрет, что в Click:
// дедуп через unique-констрейнт, накрутка бессмысленна.
model UtmClick {
  id          String   @id @default(uuid())
  ownerCode   String // персональный код автора ссылки (r…)
  targetType  String // video | market | banner | prompt | page
  targetId    String   @default("") // utm_code поста / код промпта / пусто
  visitorHash String
  createdAt   DateTime @default(now())

  @@unique([ownerCode, targetType, targetId, visitorHash])
  @@index([ownerCode])
  @@index([targetType, targetId])
}

// Профиль пользователя (task 44, п.5): кошелёк → виральные бонусы.
// bonusCredits — бесплатные прогнозы без риска (mode "bonus" в CryoBet);
// badges — JSON-массив строк ("early", "seer"); invitedBy — код
// пригласившего при первом входе (обоим начисляется бонус).
model UserProfile {
  wallet       String   @id // lowercase base58 / 0x…
  bonusCredits Int      @default(0)
  badges       String   @default("[]") // JSON: ["early","seer"]
  invitedBy    String? // персональный код пригласившего (если был)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Task 44 — персональные UTM, бонусы, Magic Link.
// ─────────────────────────────────────────────────────────────────────────────

// Одноразовые токены Magic Link (task 44, п.6): email-вход как ДОПОЛНЕНИЕ
// к кошельку. Храним только sha256(token) — утечка БД не раскрывает ссылки.
// TTL 15 минут, одноразовый (usedAt), ставка через Resend (free 3000/мес).
model MagicLogin {
  id        String    @id @default(uuid())
  email     String // lowercase
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Email-аккаунт с опционально привязанным кошельком (task 44, п.6):
// связывание обеих личностей — при verify с активной wallet-сессией
// или при wallet-авторизации с активной email-сессией (best-effort).
model MagicUser {
  email     String   @id // lowercase
  wallet    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// v8 — вход/регистрация через СВОЮ форму (email + пароль) на Supabase Postgres.
//
// БЕЗ подтверждения учётной записи: почта не проверяется письмом. Если email
// уже существует — игрок входит (сверка scrypt-хеша); если почта уникальна —
// профиль создаётся (привязка к мгновенному Account, NR PASS поднимается).
//
// ХРАНИМ ТОЛЬКО ХЕШ: scrypt (node:crypto, N=16384), формат
// `scrypt$<saltHex>$<hashHex>`. Утечка БД не раскрывает пароли.
// Сессия — тот же httpOnly-cookie nr_uid, что и у google/magic-входа.
model EmailAuth {
  accountId    String   @id // 1:1 с Account.id
  email        String   @unique // lowercase
  passwordHash String // scrypt$salt$hash
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// v9 — закрытый запуск: промокоды + лист ожидания + анти-брутфорс.
// ─────────────────────────────────────────────────────────────────────────────

// Одноразовый промокод закрытого запуска. Регистрация с валидным кодом
// создаёт аккаунт сразу; без кода (или с чужим/использованным) —
// WaitlistEntry. Код выкупается АТОМАРНО: updateMany с guard'ом
// usedBy=null → повторное применение того же кода физически невозможно
// (гонка двух регистраций с одним кодом даёт ровно один победителя).
//
// Формат NR-XXXX-XXXX-XXXX, алфавит 31 символ без 0/O/1/I/L:
// 31^12 ≈ 7.9e17 вариантов — перебор бессмыслен даже с сетью.
model PromoCode {
  id        String    @id @default(uuid())
  code      String    @unique // NR-… в верхнем регистре
  batch     String    @default("v9") // партия печати ("launch-2026-09", "selftest")
  usedBy    String? // Account.id, погасивший код
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([usedBy])
  @@index([batch])
}

// Лист ожидания: регистрация БЕЗ промокода (или с недействительным).
// Email уникален — повторная регистрация того же email обновляет пароль
// и не плодит строк (анти-спам upsert). passwordHash храним, чтобы
// будущий апрув мог создать EmailAuth без повторного ввода пароля
// (google-записи приходят с пустым хешем — пароля у Google нет).
model WaitlistEntry {
  id                 String    @id @default(uuid())
  email              String    @unique // lowercase
  passwordHash       String    @default("") // scrypt$… | "" для google-заявок
  source             String    @default("form") // form | google
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  approvedAt         DateTime? // когда переведён в аккаунт
  convertedAccountId String?

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────────
// v11 — Season 1: 7-дневный игровой цикл со снапшотом для BD.
// Одна активная строка (code="s1"). Снапшот — 12:00 UTC дня endsAt
// (GET /api/admin/snapshot): CSV userId,telegramId,eye,score,bets,correct,weight.
// Формула веса (зафиксирована на сезон, менять нельзя):
//   weight = eye * min(1, valid_bets / 10)
// В срез попадают аккаунты с ≥ 5 валидными (settled) ставками сезона;
// аккаунты «только welcome, 0 ставок» отсеваются автоматически.
// После среза сезон архивируется (status=archived), Season 2 — новые очки.
model Season {
  id        String   @id @default(uuid())
  code      String   @unique // "s1"
  name      String   @default("Season 1")
  startsAt  DateTime // 00:00 UTC дня старта (всё, что поставлено сегодня — в срезе)
  endsAt    DateTime // 12:00 UTC дня снапшота (T+7)
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Журнал попыток подбора (БД, а не память: у Vercel много изолят-процессов,
// in-memory лимит видит только свой процесс). Храним sha256(ip + соль) —
// не персональные данные, но стабильный ключ бюджета на атакующего.
// kind: promo (попытка применить код) | password (неверный пароль).
// Бюджеты: 8 промо-промахов/час и 20/сутки на ipHash; 10 неверных
// паролей/час на ipHash → 429 с Retry-After.
model PromoAttempt {
  id        String   @id @default(uuid())
  ipHash    String
  kind      String // promo | password
  ok        Boolean  @default(false)
  subject   String   @default("") // нормализованный код или email, ≤ 64 симв.
  createdAt DateTime @default(now())

  @@index([ipHash, kind, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// v2 — ставки REAL/SYNTH на клип (ТЗ v2 §4.1): вертикальный фид синтетического
// кино + спор на каждый клип. Пари-мьютюэль: пул реальных против пула
// синтетических, рейк платформе, доля автора клипа, доля реферера.
// ─────────────────────────────────────────────────────────────────────────────

// Раунд ставок на один клип. Открывается лениво (ensureOpenRound) при первом
// взгляде на клип с truth; окно ставок BET_WINDOW_SEC (15–60с). Truth клипа
// живёт в posts.csv и НЕ хранится здесь до резолва — клиент не может её
// прочитать из БД или API, пока round.status != "resolved".
//
// status: open → locked (closesAt истёк) → resolved (пулы посчитаны).
// resolved_as: "real" | "synth" — появляется ТОЛЬКО после резолва.
model Round {
  id              String    @id @default(uuid())
  clipCode        String // utm_code поста из posts.csv (truth в CSV, не здесь)
  opensAt         DateTime
  closesAt        DateTime
  poolRealCents   Int       @default(0) // активные ставки на REAL, центы
  poolSynthCents  Int       @default(0) // активные ставки на SYNTH, центы
  status          String    @default("open") // open | locked | resolved
  challenge       Boolean   @default(false) // v13: Daily Challenge раунда дня
  resolvedAs      String? // real | synth
  rakeCents       Int? // рейк платформы (RAKE_PCT от общего пула)
  authorShareCents Int? // доля автора клипа (AUTHOR_SHARE_OF_RAKE × рейк)
  refShareCents   Int? // суммарная доля рефереров (REF_RATE_PCT × рейк)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bets Bet[]

  @@index([clipCode, status])
  @@index([status, closesAt])
}

// Ставка. Без аккаунта: bettorId — анонимная httpOnly-cookie (nr_bet),
// fingerprint — visitorHash (ip+ua+секрет) для анти-фрода.
// 1 активная ставка на раунд с одного bettorId (проверка в коде при placeBet).
//
// status:
//   pending — инвойс 2328.io создан, ждём оплату (в пуле НЕ участвует)
//   active  — оплачена / demo — участвует в пуле
//   won     — резолв: сторона угадана, payoutCents > 0
//   lost    — резолв: сторона не угадана
//   late    — оплачена ПОСЛЕ резолва раунда: возврат/ручной разбор
//   failed  — инвойс отменён/недоплачен
// payout: хранится прямо здесь (ledger) — отдельная таблица Payout избыточна
// для MVP; вывод — ручной через админ-реестр.
model Bet {
  id          String   @id @default(uuid())
  roundId     String
  clipCode    String
  side        String // real | synth
  amountCents Int // 100..500 (MIN/MAX_BET_CENTS)
  bettorId    String // анонимная cookie nr_bet (uuid)
  fingerprint String // visitorHash (ip+ua+secret) — анти-фрод
  wallet      String? // кошелёк, если авторизован (вывод/рефка)
  refCode     String? // код пригласившего (r…) — 20% с рейка его ставки
  mode        String   @default("demo") // demo | crypto | balance
  // v6: balance-ставки списываются с внутреннего баланса аккаунта (nr_uid);
  // выигрыш резолва зачисляется обратно в баланс через LedgerTxn
  accountId   String?
  orderId     String?  @unique // rb-<betId>[-<ref>] — вшит в платёж 2328
  paymentId   String?  @unique // uuid платежа 2328 (webhook)
  status      String   @default("pending")
  payoutCents Int?
  // v14 — вес $NR: betSec — секунда ставки от opensAt; weightMilli —
  // min(stake, 50 EYE) × decay (первые 5с ×1, середина ×0.4, последние 5с ×0),
  // считается ТОЛЬКО у won-ставок при резолве (милледесятые, int).
  betSec        Int?
  weightMilli   Int?
  decayMilli    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  round Round @relation(fields: [roundId], references: [id])

  @@index([roundId, side])
  @@index([roundId, status])
  @@index([bettorId])
  @@index([fingerprint])
  @@index([refCode])
  @@index([bettorId, status])
}

// События аналитики (ТЗ v2 §4.3.10 — «обязательно писать»):
// clip_view, bet_placed, bet_won, bet_lost, ref_click, ref_converted,
// share_click, prompt_upsell_click. Без них нельзя крутить приток.
// Пишутся сервером (bet-жизненный цикл) и через POST /api/track/event.
model TrackEvent {
  id          String   @id @default(uuid())
  name        String
  clipCode    String   @default("")
  visitorHash String   @default("")
  meta        String   @default("{}") // JSON-строка
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([clipCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// v5 — платные размещения предикшен-ленты (Boosted / Featured Clip).
//
// Создатель платит крипто-инвойсом 2328.io (orderId bs-<id>) → webhook paid
// ставит paidUntil = now + days×24h → ранжирование getRankedPosts поднимает
// клип наверх ленты /bet и вешает чип FEATURED. Идемпотентность — та же,
// что у ставок: updateMany pending→paid, повторный webhook даёт 0 строк.
model BoostOrder {
  id          String    @id @default(uuid())
  clipCode    String // utm_code поста из posts.csv
  buyerHash   String // nr_buyer cookie (anonymous UUID)
  orderId     String    @unique // bs-<id> — вшит в инвойс 2328
  paymentId   String?   @unique // uuid платежа 2328 (webhook)
  amountUsdt  String    @default("0")
  days        Int       @default(1) // 1 | 3 | 7
  status      String    @default("pending") // pending | paid | failed
  paidUntil   DateTime? // ранжирование смотрит только сюда
  txid        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clipCode])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// v14 — таблица clips: единственный источник контента (CSV удалён из дерева).
//
// ЖИЗНЕННЫЙ ЦИКЛ: queued → live → resolved (или void). Планировщик берёт
// самый старый queued, когда нет live, и открывает окно BET_WINDOW_SEC.
// По closes_at ОДНА транзакция: метка, банк, вес, reveal. Повтор
// идемпотентен. Ставок нет — резолв всё равно есть. Битая ссылка — void,
// ставки назад, метка не раскрывается. Ручной override — только на void.
//
// СЕКРЕТНОСТЬ:
//   - video_url живёт ТОЛЬКО на сервере; клиент играет через прокси
//     /api/clip/[id]/video;
//   - label + label_commit: commit = sha256(label + ':' + id + ':' + COMMIT_PEPPER);
//     метка не отдаётся никому до resolved (RLS default-deny + гранты колонок,
//     представление clip_reveals показывает метку и хеш только после резолва);
//   - публичный раунд отдаёт id, прокси видео, closes_at, пулы, label_commit —
//     и НЕ отдаёт метку, автора, исходную ссылку.
//
// caption_public проходит фильтр запрещённых слов (seedance, higgsfield,
// kling, runway, veo, ai, prompt, нейро) при вставке и при выдаче.
model Clip {
  id            String    @id // публичный код (для миграции — utm_code из CSV)
  sourceUrl     String    @unique @map("source_url") // исходная ссылка — только серверу
  videoUrl      String    @map("video_url") // прямой MP4 — только серверу (клиент: прокси)
  authorHandle  String    @default("") @map("author_handle") // только серверу (в раунд не отдаётся)
  captionPublic String    @default("") @map("caption_public") // подпись после фильтра запрещённых слов
  label         String // real | synth — RLS закрывает до resolved
  labelCommit   String    @map("label_commit") // sha256(label:id:COMMIT_PEPPER)
  status        String    @default("queued") // queued | live | resolved | void
  opensAt       DateTime? @map("opens_at")
  closesAt      DateTime? @map("closes_at")
  resolvedAt    DateTime? @map("resolved_at")
  listedBy      String    @default("bd") @map("listed_by") // кто внёс клип в очередь
  // витрина ленты (наследие витрины CSV): featured — админ-флаг, badge —
  // косметика карточки, pin — абсолютный слот в ленте
  featuredUntil DateTime? @map("featured_until")
  badge         String    @default("")
  pin           Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([status, closesAt])
  @@map("clips")
}

// v14 — касса: ровно ДВА платежа, инвойс создаёт только сервер.
//   kind = "pack": order_id = "eye-" + accountId + "-" + sku + "-" + nonce
//     пачки EYE: 100 = 1 USDT, 300 = 2.5 USDT, 1000 = 7 USDT.
//     paid → EYE дописывается в игровой леджер один раз (refKey pack:<orderId>).
//     Инвойс НЕ минтит $NR и НЕ пишет сезонный вес.
//   kind = "rev": order_id = "rev-" + accountId, ровно 3 USDT, один раз.
//     paid → revshare = true (процент по ссылке включён).
// Вебхук 2328 сверяет подпись и идемпотентен по order_id; редирект не
// начисляет и не включает статус.
model PayOrder {
  id          String    @id @default(uuid())
  accountId   String    @map("accountId")
  orderId     String    @unique @map("order_id")
  kind        String // pack | rev
  sku         Int? // 100 | 300 | 1000 (pack)
  eyeAmount   Int?      @map("eye_amount") // сколько EYE начислить (pack)
  amountMicros Int      @map("amount_micros") // цена в USDT-микро (1 USDT = 1_000_000)
  paymentId   String?   @unique @map("payment_id")
  status      String    @default("pending") // pending | paid | failed
  txid        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  paidAt      DateTime? @map("paid_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([accountId, status])
  @@index([status])
  @@map("pay_orders")
}

// v14 — merkle-клейм сезона (ТЗ §Раздача $NR): Base, фикс-саплай, пресейла
// нет. Адрес публикуется ТОЛЬКО на этом домене после снапшота; клейм
// merkle, один раз. Строится админом после снапшота, когда собраны
// адреса игроков: root + proofs хранятся здесь; до клейма публичны
// только ранг и число ранних верных коллов — НЕ число монет.
model SeasonClaim {
  id         String   @id @default(uuid())
  seasonCode String   @unique @map("season_code")
  root       String
  supply     Int
  gamePack   Int      @map("game_pack")
  claimsJson String   @map("claims_json") // [{address, amount, proof[]}] — server-only
  leafCount  Int      @default(0) @map("leaf_count")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("season_claims")
}

// v14 — регистрация Base-адреса для клейма (ТЗ: «Адрес только на этом
// домене после снапшота. Клейм merkle, один раз»).
//   - accountId unique: у аккаунта ровно одна попытка (один раз);
//   - address unique: один адрес не может собрать два клейма;
//   - принимается ТОЛЬКО после снапшота сезона (guard в /api/me/nr).
model ClaimAddress {
  id         String   @id @default(uuid())
  seasonCode String   @map("season_code")
  accountId  String   @unique @map("account_id")
  address    String   @unique // 0x… (lowercase), Base
  txHash     String?  @map("tx_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("claim_addresses")
}
