# Скопируйте в .env и поправьте под своё окружение
# SQLite: путь относительно prisma/schema.prisma
DATABASE_URL="file:../db/custom.db"

# Соль для хеширования посетителей при подсчёте кликов (опционально)
ADMIN_SECRET="change-me"

# --- Платные промпты: 2328.io (https://doc.2328.io) ---
# Ключ приёма платежей (Create Payment) — используется ТОЛЬКО на бэкенде
TWOTHOUSAND328_PAYMENT_API_KEY=""
# UUID проекта из настроек 2328.io (общий для payment и payout)
TWOTHOUSAND328_PROJECT_UUID=""
# Ключ выплат автору (Payout/Cashout) — ОТДЕЛЬНЫЙ, генерится в настройках проекта
TWOTHOUSAND328_PAYOUT_API_KEY=""
# Комиссия платформы (0.25 = 25%), остальное уходит автору
PLATFORM_COMMISSION_RATE="0.25"
# Публичный https-URL сайта (для url_callback/url_return 2328);
# на Vercel можно не задавать — собирается из заголовков запроса
PUBLIC_BASE_URL=""
# Авто-выплата автору сразу после оплаты ("true"). По умолчанию выключено:
# покупки копятся в ready_for_payout и выплачиваются через
# POST /api/admin/payouts?key=<ADMIN_SECRET>
PAYOUT_AUTO="false"
# Сеть выплат USDT (TRX-TRC20 | ETH-ERC20 | BSC-BEP20 | ...)
# TWOTHOUSAND328_PAYOUT_NETWORK="TRX-TRC20"

# --- Task 44: feature flags (все новые механики выключаются без кода) ---
# Персональные UTM-переходы (api/track/ref, атрибуция в /r/[code])
FEATURE_UTM_TRACKING="1"
# Виральные бонусы: welcome free bets, бейджи early/seer
FEATURE_BONUSES="1"
# Нарративные опции рынка «what happens next» (2–4 варианта)
FEATURE_NARRATIVE_MARKETS="1"
# Приём асинхронных кликов от Cloudflare Worker (api/track/click)
FEATURE_CLICK_WORKER="0"
# Секрет Worker'а (тот же, что `wrangler secret put CLICK_WORKER_SECRET`)
CLICK_WORKER_SECRET=""

# --- Task 44: Magic Link (email-вход, бесплатно через Resend) ---
# Без ключа фича выключена автоматически; FEATURE_MAGIC_LINK=0 — принудительно
RESEND_API_KEY=""
# Отправитель (по умолчанию onboarding@resend.dev на free-тарифе Resend)
MAIL_FROM=""
FEATURE_MAGIC_LINK="1"

# --- Task 44: Cloudflare Web Analytics (beacon в layout) ---
NEXT_PUBLIC_CF_BEACON_TOKEN=""

# --- Task 44: USDC-канал предикшенов (без treasury — demo-режим) ---
NEXT_PUBLIC_PREDICT_TREASURY=""
PREDICT_TREASURY_ATA=""
NEXT_PUBLIC_PREDICT_USDC_MINT=""
PREDICT_RPC_URL=""
